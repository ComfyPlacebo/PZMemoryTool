<?xml version="1.0" encoding="utf-8"?>
<!--
  PZ Memory Tool - Windows application manifest.
  Tells Windows the tool runs with normal user rights (it only asks for
  administrator rights if a save needs them) and that it supports
  Windows 10 and 11.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.1.0.0" name="ComfyPlacebo.PZMemoryTool" type="win32" />
  <description>PZ Memory Tool - sets Project Zomboid's memory allocation</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
